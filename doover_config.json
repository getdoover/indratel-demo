{
    "indratel_demo": {
        "name": "indratel_demo",
        "display_name": "Site Overview",
        "type": "PRO",
        "visibility": "PUB",
        "allow_many": false,
        "description": "Polished site-overview dashboard for the Indratel demo device - live tank levels, flow and rainfall in one panel.",
        "long_description": "README.md",
        "depends_on": [],
        "handler": "src.indratel_demo.handler",
        "lambda_config": {
            "Runtime": "python3.13",
            "Timeout": 300,
            "MemorySize": 128,
            "Handler": "src.indratel_demo.handler"
        },
        "organisation_id": 182001610510090497,
        "key": null,
        "owner_org_id": 182001610510090497,
        "code_repo_id": null,
        "container_registry_profile_id": null,
        "repo_branch": "main",
        "image_name": null,
        "icon_url": "",
        "staging_config": {},
        "export_config_command": "export-config",
        "export_ui_command": "export-ui",
        "build_widget_command": "npm --prefix dashboard-widget run build",
        "widget": "dashboard-widget/assets/IndratelDemoWidget.js",
        "run_command": null,
        "lambda_arn": null,
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {
                "dv_proc_subscriptions": {
                    "title": "Channel Subscription",
                    "x-name": "dv_proc_subscriptions",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "The name of the channel to subscribe to",
                    "default": "deployment_config",
                    "x-position": 0
                },
                "site_name": {
                    "title": "Site Name",
                    "x-name": "site_name",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Heading shown at the top of the dashboard.",
                    "default": "Indratel Demo Site",
                    "x-position": 1
                },
                "tank_1_app": {
                    "title": "Tank 1 App",
                    "x-name": "tank_1_app",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "App install key of the 4-20mA sensor measuring tank 1 (as it appears on the device).",
                    "default": "4_20ma_sensor_1",
                    "x-position": 2
                },
                "tank_2_app": {
                    "title": "Tank 2 App",
                    "x-name": "tank_2_app",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "App install key of the 4-20mA sensor measuring tank 2 (as it appears on the device).",
                    "default": "4_20ma_sensor_2",
                    "x-position": 3
                },
                "flow_meter_app": {
                    "title": "Flow Meter App",
                    "x-name": "flow_meter_app",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "App install key of the analog flow meter.",
                    "default": "analog_flow_meter_1",
                    "x-position": 4
                },
                "rain_gauge_app": {
                    "title": "Rain Gauge App",
                    "x-name": "rain_gauge_app",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "App install key of the analog rain gauge. Leave as-is if not installed yet - the panel stays dormant until it reports.",
                    "default": "analog_rain_gauge_1",
                    "x-position": 5
                }
            },
            "additionalElements": true,
            "required": []
        },
        "banner_url": null,
        "ui_schema": {
            "displayString": "$config.app().APP_DISPLAY_NAME",
            "hidden": "$config.app().hidden:boolean:false:boolean:false",
            "position": "$config.app().dv_app_position:number:100",
            "icon": null,
            "colour": null,
            "defaultOpen": true,
            "type": "uiApplication",
            "name": "$config.app().APP_KEY",
            "children": {
                "IndratelDemoWidget": {
                    "name": "IndratelDemoWidget",
                    "type": "uiRemoteComponent",
                    "displayString": "Site Overview",
                    "showActivity": true,
                    "componentUrl": "$config.app().dv_widget_url",
                    "position": 51,
                    "hidden": false,
                    "children": {},
                    "scope": "IndratelDemoWidget",
                    "module": "./IndratelDemoWidget",
                    "app_key": "$config.app().APP_KEY",
                    "site_name": "$config.app().site_name",
                    "tank_1_app": "$config.app().tank_1_app",
                    "tank_2_app": "$config.app().tank_2_app",
                    "flow_meter_app": "$config.app().flow_meter_app",
                    "rain_gauge_app": "$config.app().rain_gauge_app"
                }
            }
        }
    }
}