{
    "indratel_demo": {
        "name": "indratel_demo",
        "display_name": "Site Overview",
        "type": "PRO",
        "visibility": "PUB",
        "allow_many": false,
        "description": "Site overview for the Indratel demo device - tank levels, pulse flow meters and Elpro diagnostics in one panel.",
        "long_description": "README.md",
        "depends_on": [],
        "handler": "src.indratel_demo.handler",
        "lambda_config": {
            "Runtime": "python3.13",
            "Timeout": 300,
            "MemorySize": 128,
            "Handler": "src.indratel_demo.handler"
        },
        "organisation_id": 182001610510090497,
        "key": null,
        "owner_org_id": 182001610510090497,
        "code_repo_id": null,
        "container_registry_profile_id": null,
        "repo_branch": "main",
        "image_name": null,
        "icon_url": "",
        "staging_config": {},
        "export_config_command": "export-config",
        "export_ui_command": "export-ui",
        "build_widget_command": "npm --prefix dashboard-widget run build",
        "widget": "dashboard-widget/assets/IndratelDemoWidget.js",
        "run_command": null,
        "lambda_arn": null,
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {
                "dv_proc_subscriptions": {
                    "title": "Channel Subscription",
                    "x-name": "dv_proc_subscriptions",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "The name of the channel to subscribe to",
                    "default": "deployment_config",
                    "x-position": 0
                },
                "site_name": {
                    "title": "Site Name",
                    "x-name": "site_name",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Heading shown at the top of the dashboard.",
                    "default": "Indratel Demo Site",
                    "x-position": 1
                },
                "tank_1_app": {
                    "title": "Tank 1 App",
                    "x-name": "tank_1_app",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "App install key of the 4-20mA sensor measuring tank 1.",
                    "default": "4_20ma_sensor_1",
                    "x-position": 2
                },
                "tank_2_app": {
                    "title": "Tank 2 App",
                    "x-name": "tank_2_app",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "App install key of the 4-20mA sensor measuring tank 2.",
                    "default": "4_20ma_sensor_2",
                    "x-position": 3
                },
                "flow_1_app": {
                    "title": "Flow 1 App",
                    "x-name": "flow_1_app",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "App install key of the first pulse flow meter.",
                    "default": "analog_flow_meter_1",
                    "x-position": 4
                },
                "flow_2_app": {
                    "title": "Flow 2 App",
                    "x-name": "flow_2_app",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "App install key of the second pulse flow meter.",
                    "default": "analog_flow_meter_2",
                    "x-position": 5
                },
                "elpro_app": {
                    "title": "Elpro App",
                    "x-name": "elpro_app",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "App install key of the ELPRO Quantum diagnostics app, which supplies the battery, charger and radio readings. Without it the panel falls back to the bare voltage the platform interface publishes.",
                    "default": "elpro_quantum_diagnostics_1",
                    "x-position": 6
                },
                "platform_app": {
                    "title": "Platform App",
                    "x-name": "platform_app",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Tag namespace the platform interface publishes under. Used only as a fallback when the ELPRO diagnostics app is not installed. This is the app's tag key ('platform'), not its install key.",
                    "default": "platform",
                    "x-position": 7
                },
                "show_diagnostics": {
                    "title": "Show Diagnostics",
                    "x-name": "show_diagnostics",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Show the hardware diagnostics panel.",
                    "default": true,
                    "x-position": 8
                }
            },
            "additionalElements": true,
            "required": []
        },
        "banner_url": null,
        "ui_schema": {
            "displayString": "$config.app().APP_DISPLAY_NAME",
            "hidden": "$config.app().hidden:boolean:false:boolean:false",
            "position": "$config.app().dv_app_position:number:100",
            "icon": null,
            "colour": null,
            "defaultOpen": true,
            "type": "uiApplication",
            "name": "$config.app().APP_KEY",
            "children": {
                "IndratelDemoWidget": {
                    "name": "IndratelDemoWidget",
                    "type": "uiRemoteComponent",
                    "displayString": "Site Overview",
                    "showActivity": true,
                    "componentUrl": "$config.app().dv_widget_url",
                    "position": 51,
                    "hidden": false,
                    "children": {},
                    "scope": "IndratelDemoWidget",
                    "module": "./IndratelDemoWidget",
                    "app_key": "$config.app().APP_KEY",
                    "site_name": "$config.app().site_name",
                    "tank_1_app": "$config.app().tank_1_app",
                    "tank_2_app": "$config.app().tank_2_app",
                    "flow_1_app": "$config.app().flow_1_app",
                    "flow_2_app": "$config.app().flow_2_app",
                    "elpro_app": "$config.app().elpro_app",
                    "platform_app": "$config.app().platform_app",
                    "show_diagnostics": "$config.app().show_diagnostics:boolean:true"
                }
            }
        }
    }
}